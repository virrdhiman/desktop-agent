# VD Agent local development environment.
# Copy to .env only on your own machine. Never commit real keys.

# Optional LangSmith export/tracing. Disabled unless you explicitly opt in.
LANGSMITH_TRACING=false
LANGSMITH_PROJECT=vd-agent-local-evals
# LANGSMITH_API_KEY=
# LANGCHAIN_API_KEY=
# LANGSMITH_ENDPOINT=https://api.smith.langchain.com

# Optional Arize/Phoenix trace import/export. Disabled unless explicitly used.
# ARIZE_API_KEY=
# ARIZE_SPACE_ID=
# ARIZE_BASE_URL=https://api.arize.com/v2
# ARIZE_DATASET_NAME=VD Agent Golden Evals
# PHOENIX_API_KEY=
# PHOENIX_COLLECTOR_ENDPOINT=

# Optional provider keys used by local development. Keep real values in .env.local.
# The app reads user-data .env.local (and the repo .env.local while unpackaged).
# VD_AGENT_ENV_FILE=/path/to/another.env.local
# VD_AGENT_DISABLE_ENV_IMPORT=1
# GROQ_API_KEY=
# OPENROUTER_API_KEY=
# GEMINI_API_KEY=
# MISTRAL_API_KEY=
# NVIDIA_API_KEY=
# LLM7_API_KEY=
# OLLAMA_API_KEY_OR_URL=
# CLOUDFLARE_ACCOUNT_ID=
# CLOUDFLARE_API_TOKEN=

# Optional external language servers for full non-TS editor intelligence.
# Leave unset to use workspace text fallback when the server is not installed.
# VD_AGENT_LSP_PYTHON=pyright-langserver --stdio
# VD_AGENT_LSP_GO=gopls serve
# VD_AGENT_LSP_RUST=rust-analyzer
# VD_AGENT_LSP_CLANGD=clangd --background-index
# VD_AGENT_LSP_CSHARP=csharp-ls

# Optional: write hosted-eval JSONL after npm run agent:evals.
VD_EVAL_TRACE_EXPORT=0
