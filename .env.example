# VD Agent local development environment.
# Copy to .env only on your own machine. Never commit real keys.

# Optional LangSmith export/tracing. Disabled unless you explicitly opt in.
LANGSMITH_TRACING=false
LANGSMITH_PROJECT=vd-agent-local-evals
# LANGSMITH_API_KEY=
# LANGCHAIN_API_KEY=
# LANGSMITH_ENDPOINT=https://api.smith.langchain.com

# Optional Arize/Phoenix trace import/export. Disabled unless explicitly used.
# ARIZE_API_KEY=
# ARIZE_SPACE_ID=
# PHOENIX_API_KEY=
# PHOENIX_COLLECTOR_ENDPOINT=

# Optional: write hosted-eval JSONL after npm run agent:evals.
VD_EVAL_TRACE_EXPORT=0
