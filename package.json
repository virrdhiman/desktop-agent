{
  "name": "vd-agent",
  "productName": "VD Agent",
  "version": "1.1.0",
  "type": "module",
  "private": true,
  "description": "VD Agent: desktop AI coding agent with free API key model selection, git, terminal, and local chat history",
  "license": "SEE LICENSE IN LICENSE",
  "engines": {
    "node": ">=22.19.0"
  },
  "allowScripts": {
    "node-pty": true
  },
  "author": {
    "name": "Virender Dhiman",
    "email": "virrdhiman@gmail.com",
    "url": "https://virender.in"
  },
  "homepage": "https://github.com/virrdhiman/desktop-agent",
  "repository": {
    "type": "git",
    "url": "https://github.com/virrdhiman/desktop-agent.git"
  },
  "bugs": {
    "url": "https://github.com/virrdhiman/desktop-agent/issues"
  },
  "keywords": [
    "ai",
    "agent",
    "coding-agent",
    "desktop",
    "electron",
    "code",
    "git",
    "llm",
    "openai-compatible",
    "vd-agent",
    "virender-dhiman"
  ],
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:reliability": "vitest run electron/__tests__/reliability.test.ts electron/__tests__/archiveStore.test.ts electron/__tests__/diagnostics.test.ts",
    "lint": "tsc --noEmit",
    "smoke": "npm run build && node scripts/smoke.mjs",
    "agent:evals": "node scripts/agent-evals.mjs",
    "agent:evals:export": "node scripts/hosted-eval-export.mjs",
    "agent:evals:import": "node scripts/hosted-eval-import.mjs",
    "icons": "node scripts/generate-icons.mjs",
    "verify": "npm run lint && npm test && npm run build",
    "bundle:budget": "node scripts/bundle-budget.mjs",
    "security:audit": "npm audit --omit=dev --audit-level=high",
    "checksums": "node scripts/checksums.mjs",
    "release:notes": "node scripts/release-notes.mjs",
    "release:qa": "node scripts/release-qa.mjs",
    "release:vm-qa": "node scripts/clean-vm-qa.mjs",
    "vm:setup": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/setup-vm-host.ps1",
    "vm:create": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/create-clean-vm.ps1",
    "vscode:package": "node scripts/package-vscode-extension.mjs",
    "electron:dev": "vite --config vite.config.ts",
    "electron:build": "vite build && electron-builder"
  },
  "dependencies": {
    "@monaco-editor/react": "^4.7.0",
    "electron-updater": "^6.8.9",
    "monaco-editor": "^0.50.0",
    "node-pty": "^1.1.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^9.0.1",
    "simple-git": "^3.25.0",
    "typescript": "^5.9.3",
    "xterm": "^5.3.0",
    "xterm-addon-fit": "^0.8.0",
    "xterm-addon-web-links": "^0.9.0",
    "yauzl": "^3.4.0",
    "zustand": "^4.5.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.6",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@types/yauzl": "^2.10.3",
    "@types/yazl": "^3.3.1",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3",
    "eslint": "^10.9.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.4",
    "jsdom": "^30.0.1",
    "typescript-eslint": "^8.67.0",
    "vite": "^7.3.6",
    "vite-plugin-electron": "^0.28.8",
    "vite-plugin-electron-renderer": "^0.14.5",
    "vitest": "^4.1.11",
    "yazl": "^3.3.1"
  },
  "overrides": {
    "js-yaml": "^4.3.2",
    "undici": "^8.10.2"
  },
  "build": {
    "npmRebuild": false,
    "forceCodeSigning": false,
    "appId": "com.vd.agent",
    "productName": "VD Agent",
    "electronUpdaterCompatibility": ">=2.16",
    "publish": {
      "provider": "github",
      "owner": "virrdhiman",
      "repo": "desktop-agent"
    },
    "copyright": "Copyright © 2025-2026 Virender Dhiman (virender.in). All rights reserved.",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "node_modules/typescript/**/*"
    ],
    "extraFiles": [
      {
        "from": "LICENSE",
        "to": "LICENSE.txt"
      }
    ],
    "extraResources": [
      {
        "from": "build/icon.png",
        "to": "icon.png"
      },
      {
        "from": "build/icon.ico",
        "to": "icon.ico"
      },
      {
        "from": "vscode-extension/vd-agent-vscode-bridge-0.4.4.vsix",
        "to": "vd-agent-vscode-bridge-0.4.4.vsix"
      }
    ],
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.developer-tools",
      "darkModeSupport": true
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "build/icon.ico",
      "requestedExecutionLevel": "asInvoker",
      "signAndEditExecutable": false
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "icon": "build/icon.png",
      "category": "Development"
    },
    "nsis": {
      "oneClick": false,
      "license": "LICENSE",
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "VD Agent"
    }
  }
}
