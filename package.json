{
  "name": "freebuff-agent",
  "version": "1.0.0",
  "type": "module",
  "description": "Desktop AI agent with local file access, git operations, and multi-provider API support",
  "author": "Virender Dhiman <virenderdhiman@gmail.com>",
  "homepage": "https://github.com/virenderdhiman/freebuff-agent",
  "repository": {
    "type": "git",
    "url": "https://github.com/virenderdhiman/freebuff-agent"
  },
  "keywords": ["ai", "agent", "desktop", "electron", "cursor", "code", "git", "llm", "openai", "free", "virender-dhiman"],
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "tsc --noEmit",
    "electron:dev": "vite --config vite.config.ts",
    "electron:build": "vite build && electron-builder"
  },
  "dependencies": {
    "@monaco-editor/react": "^4.7.0",
    "monaco-editor": "^0.50.0",
    "node-pty": "^1.1.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^9.0.1",
    "simple-git": "^3.25.0",
    "xterm": "^5.3.0",
    "xterm-addon-fit": "^0.8.0",
    "xterm-addon-web-links": "^0.9.0",
    "zustand": "^4.5.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.6",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "electron": "^31.3.1",
    "electron-builder": "^24.13.3",
    "eslint": "^10.9.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.4",
    "jsdom": "^30.0.1",
    "typescript": "^5.5.3",
    "typescript-eslint": "^8.67.0",
    "vite": "^5.4.0",
    "vite-plugin-electron": "^0.28.8",
    "vite-plugin-electron-renderer": "^0.14.5",
    "vitest": "^4.1.11"
  },
  "build": {
    "npmRebuild": true,
    "forceCodeSigning": false,
    "appId": "com.freebuff.agent",
    "productName": "Freebuff Agent",
    "copyright": "Copyright © 2025 Virender Dhiman / Freebuff",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*"
    ],
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.developer-tools",
      "darkModeSupport": true
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "requestedExecutionLevel": "asInvoker",
      "signAndEditExecutable": false
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Development"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Freebuff Agent"
    }
  }
}
