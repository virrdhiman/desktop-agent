{
  "name": "vd-agent-vscode-bridge",
  "displayName": "VD Agent Bridge",
  "description": "Exports VS Code workspace/editor context, local index data, inline suggestions, and VD Agent editor commands.",
  "version": "0.3.0",
  "publisher": "virender-dhiman",
  "license": "SEE LICENSE IN ../LICENSE",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": ["Other"],
  "activationEvents": [
    "onStartupFinished",
    "onCommand:vdAgent.exportContext",
    "onCommand:vdAgent.openBridgeFile",
    "onCommand:vdAgent.processCommands",
    "onCommand:vdAgent.rebuildIndex",
    "onCommand:vdAgent.openIndexFile",
    "onCommand:vdAgent.acceptLastPreview",
    "onCommand:vdAgent.rejectLastPreview",
    "onCommand:vdAgent.showStatus",
    "onCommand:vdAgent.openDashboard"
  ],
  "main": "./extension.js",
  "contributes": {
    "commands": [
      {
        "command": "vdAgent.exportContext",
        "title": "VD Agent: Export Workspace Context"
      },
      {
        "command": "vdAgent.openBridgeFile",
        "title": "VD Agent: Open Bridge Context File"
      },
      {
        "command": "vdAgent.processCommands",
        "title": "VD Agent: Process Pending Bridge Commands"
      },
      {
        "command": "vdAgent.rebuildIndex",
        "title": "VD Agent: Rebuild Local Workspace Index"
      },
      {
        "command": "vdAgent.openIndexFile",
        "title": "VD Agent: Open Local Workspace Index"
      },
      {
        "command": "vdAgent.acceptLastPreview",
        "title": "VD Agent: Accept Last Previewed Edit"
      },
      {
        "command": "vdAgent.rejectLastPreview",
        "title": "VD Agent: Reject Last Previewed Edit"
      },
      {
        "command": "vdAgent.showStatus",
        "title": "VD Agent: Show Bridge Status"
      },
      {
        "command": "vdAgent.openDashboard",
        "title": "VD Agent: Open Bridge Dashboard"
      }
    ],
    "menus": {
      "commandPalette": [
        { "command": "vdAgent.exportContext" },
        { "command": "vdAgent.processCommands" },
        { "command": "vdAgent.rebuildIndex" },
        { "command": "vdAgent.acceptLastPreview" },
        { "command": "vdAgent.rejectLastPreview" },
        { "command": "vdAgent.showStatus" },
        { "command": "vdAgent.openDashboard" }
      ],
      "editor/title": [
        {
          "command": "vdAgent.exportContext",
          "group": "navigation"
        }
      ]
    },
    "configuration": {
      "title": "VD Agent Bridge",
      "properties": {
        "vdAgentBridge.autoExport": {
          "type": "boolean",
          "default": true,
          "description": "Automatically export active editor context for VD Agent."
        },
        "vdAgentBridge.maxSelectionChars": {
          "type": "number",
          "default": 20000,
          "minimum": 1000,
          "maximum": 200000,
          "description": "Maximum selected text characters written into the local bridge file."
        },
        "vdAgentBridge.inlineCompletion": {
          "type": "boolean",
          "default": true,
          "description": "Offer lightweight local inline completions from workspace symbols and open files."
        },
        "vdAgentBridge.autoIndex": {
          "type": "boolean",
          "default": true,
          "description": "Automatically maintain a local workspace index under .vd-agent for VD Agent context."
        },
        "vdAgentBridge.maxIndexedFiles": {
          "type": "number",
          "default": 2000,
          "minimum": 100,
          "maximum": 10000,
          "description": "Maximum workspace files indexed by the local VD Agent Bridge."
        },
        "vdAgentBridge.maxSemanticSymbolFiles": {
          "type": "number",
          "default": 350,
          "minimum": 0,
          "maximum": 2000,
          "description": "Maximum files where VS Code symbol providers are used while building the local index."
        }
      }
    }
  }
}
