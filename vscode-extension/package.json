{
  "name": "vd-agent-vscode-bridge",
  "displayName": "PIT Agent Bridge",
  "description": "Exports VS Code workspace/editor context, local index data, AI inline suggestions, and PIT Agent editor commands.",
  "version": "0.4.7",
  "publisher": "virender-dhiman",
  "license": "SEE LICENSE IN ../LICENSE",
  "engines": {
    "vscode": "^1.85.0"
  },
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "PIT Agent Bridge offers read-only status, active-editor export, and inline autocomplete in Restricted Mode. Trust the workspace to enable indexing, terminals, command execution, and edit/apply workflows."
    }
  },
  "categories": ["Other"],
  "activationEvents": [
    "onStartupFinished",
    "onCommand:vdAgent.exportContext",
    "onCommand:vdAgent.openBridgeFile",
    "onCommand:vdAgent.processCommands",
    "onCommand:vdAgent.rebuildIndex",
    "onCommand:vdAgent.openIndexFile",
    "onCommand:vdAgent.acceptLastPreview",
    "onCommand:vdAgent.rejectLastPreview",
    "onCommand:vdAgent.reviewLastPreview",
    "onCommand:vdAgent.checkAiStatus",
    "onCommand:vdAgent.selectAiModel",
    "onCommand:vdAgent.runAutocompleteSmoke",
    "onCommand:vdAgent.showStatus",
    "onCommand:vdAgent.openDashboard",
    "onCommand:vdAgent.fixWithVD",
    "onCommand:vdAgent.explainWithVD",
    "onCommand:vdAgent.refactorWithVD",
    "onCommand:vdAgent.generateTestsWithVD",
    "onCommand:vdAgent.openWorkspaceTerminal",
    "onCommand:vdAgent.goToDefinition",
    "onCommand:vdAgent.findReferences",
    "onCommand:vdAgent.renameSymbol"
  ],
  "main": "./extension.js",
  "contributes": {
    "commands": [
      {
        "command": "vdAgent.exportContext",
        "title": "PIT Agent: Export Workspace Context"
      },
      {
        "command": "vdAgent.openBridgeFile",
        "title": "PIT Agent: Open Bridge Context File"
      },
      {
        "command": "vdAgent.processCommands",
        "title": "PIT Agent: Process Pending Bridge Commands"
      },
      {
        "command": "vdAgent.rebuildIndex",
        "title": "PIT Agent: Rebuild Local Workspace Index"
      },
      {
        "command": "vdAgent.openIndexFile",
        "title": "PIT Agent: Open Local Workspace Index"
      },
      {
        "command": "vdAgent.acceptLastPreview",
        "title": "PIT Agent: Accept Last Previewed Edit"
      },
      {
        "command": "vdAgent.rejectLastPreview",
        "title": "PIT Agent: Reject Last Previewed Edit"
      },
      {
        "command": "vdAgent.reviewLastPreview",
        "title": "PIT Agent: Review Last Previewed Edit"
      },
      {
        "command": "vdAgent.checkAiStatus",
        "title": "PIT Agent: Check AI Status"
      },
      {
        "command": "vdAgent.selectAiModel",
        "title": "PIT Agent: Select AI Model"
      },
      {
        "command": "vdAgent.runAutocompleteSmoke",
        "title": "PIT Agent: Run Inline Autocomplete Smoke Test"
      },
      {
        "command": "vdAgent.showStatus",
        "title": "PIT Agent: Show Bridge Status"
      },
      {
        "command": "vdAgent.openDashboard",
        "title": "PIT Agent: Open Bridge Dashboard"
      },
      {
        "command": "vdAgent.fixWithVD",
        "title": "PIT Agent: Fix selection"
      },
      {
        "command": "vdAgent.explainWithVD",
        "title": "PIT Agent: Explain Selection"
      },
      {
        "command": "vdAgent.refactorWithVD",
        "title": "PIT Agent: Refactor Selection"
      },
      {
        "command": "vdAgent.generateTestsWithVD",
        "title": "PIT Agent: Generate Tests"
      },
      {
        "command": "vdAgent.openWorkspaceTerminal",
        "title": "PIT Agent: Open Workspace Terminal"
      },
      {
        "command": "vdAgent.goToDefinition",
        "title": "PIT Agent: Go to Definition"
      },
      {
        "command": "vdAgent.findReferences",
        "title": "PIT Agent: Find References"
      },
      {
        "command": "vdAgent.renameSymbol",
        "title": "PIT Agent: Rename Symbol"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "vdAgent",
          "title": "PIT Agent",
          "icon": "resources/vd-agent.svg"
        }
      ]
    },
    "views": {
      "vdAgent": [
        {
          "id": "vdAgent.assistantView",
          "name": "Assistant"
        }
      ]
    },
    "menus": {
      "commandPalette": [
        { "command": "vdAgent.exportContext" },
        { "command": "vdAgent.processCommands" },
        { "command": "vdAgent.rebuildIndex" },
        { "command": "vdAgent.acceptLastPreview" },
        { "command": "vdAgent.rejectLastPreview" },
        { "command": "vdAgent.reviewLastPreview" },
        { "command": "vdAgent.checkAiStatus" },
        { "command": "vdAgent.selectAiModel" },
        { "command": "vdAgent.runAutocompleteSmoke" },
        { "command": "vdAgent.showStatus" },
        { "command": "vdAgent.openDashboard" },
        { "command": "vdAgent.fixWithVD" },
        { "command": "vdAgent.explainWithVD" },
        { "command": "vdAgent.refactorWithVD" },
        { "command": "vdAgent.generateTestsWithVD" },
        { "command": "vdAgent.openWorkspaceTerminal" },
        { "command": "vdAgent.goToDefinition" },
        { "command": "vdAgent.findReferences" },
        { "command": "vdAgent.renameSymbol" }
      ],
      "editor/context": [
        {
          "command": "vdAgent.fixWithVD",
          "group": "vdAgent@1"
        },
        {
          "command": "vdAgent.explainWithVD",
          "group": "vdAgent@2"
        },
        {
          "command": "vdAgent.refactorWithVD",
          "group": "vdAgent@3"
        },
        {
          "command": "vdAgent.generateTestsWithVD",
          "group": "vdAgent@4"
        },
        {
          "command": "vdAgent.goToDefinition",
          "group": "vdAgent@5"
        },
        {
          "command": "vdAgent.findReferences",
          "group": "vdAgent@6"
        },
        {
          "command": "vdAgent.renameSymbol",
          "group": "vdAgent@7"
        }
      ],
      "editor/title": [
        {
          "command": "vdAgent.exportContext",
          "group": "navigation"
        }
      ]
    },
    "configurationDefaults": {
      "editor.inlineSuggest.enabled": true,
      "editor.suggest.preview": true
    },
    "configuration": {
      "title": "PIT Agent Bridge",
      "properties": {
        "vdAgentBridge.autoExport": {
          "type": "boolean",
          "default": true,
          "description": "Automatically export active editor context for PIT Agent."
        },
        "vdAgentBridge.maxSelectionChars": {
          "type": "number",
          "default": 20000,
          "minimum": 1000,
          "maximum": 200000,
          "description": "Maximum selected text characters written into the local bridge file."
        },
        "vdAgentBridge.inlineCompletion": {
          "type": "boolean",
          "default": true,
          "description": "Offer lightweight local inline completions from workspace symbols and open files."
        },
        "vdAgentBridge.aiInlineCompletion": {
          "type": "boolean",
          "default": true,
          "description": "Try local/OpenAI-compatible AI inline completions before falling back to symbol completions."
        },
        "vdAgentBridge.aiProvider": {
          "type": "string",
          "enum": ["ollama", "openai-compatible", "disabled"],
          "default": "ollama",
          "description": "Provider used for AI inline completions and native editor commands. Ollama is local and no-budget."
        },
        "vdAgentBridge.aiBaseUrl": {
          "type": "string",
          "default": "http://localhost:11434",
          "description": "Base URL for Ollama or an OpenAI-compatible provider."
        },
        "vdAgentBridge.aiModel": {
          "type": "string",
          "default": "qwen2.5-coder:1.5b",
          "description": "Fast model used for AI autocomplete and native editor commands."
        },
        "vdAgentBridge.aiApiKey": {
          "type": "string",
          "default": "",
          "description": "Optional API key for OpenAI-compatible providers. Leave blank for local Ollama."
        },
        "vdAgentBridge.aiAutocompleteDelayMs": {
          "type": "number",
          "default": 220,
          "minimum": 50,
          "maximum": 1200,
          "description": "Debounce delay before requesting AI inline autocomplete."
        },
        "vdAgentBridge.aiAutocompleteTimeoutMs": {
          "type": "number",
          "default": 7000,
          "minimum": 500,
          "maximum": 10000,
          "description": "Maximum time to wait for an AI inline completion before using local fallback. The default leaves room for a cold local Ollama model."
        },
        "vdAgentBridge.vsCodeCompletionFallback": {
          "type": "boolean",
          "default": true,
          "description": "Use VS Code language-server completion items as a no-cost inline fallback."
        },
        "vdAgentBridge.autoIndex": {
          "type": "boolean",
          "default": true,
          "description": "Automatically maintain a local workspace index under .vd-agent for PIT Agent context."
        },
        "vdAgentBridge.maxIndexedFiles": {
          "type": "number",
          "default": 2000,
          "minimum": 100,
          "maximum": 10000,
          "description": "Maximum workspace files indexed by the local PIT Agent Bridge."
        },
        "vdAgentBridge.maxSemanticSymbolFiles": {
          "type": "number",
          "default": 350,
          "minimum": 0,
          "maximum": 2000,
          "description": "Maximum files where VS Code symbol providers are used while building the local index."
        }
      }
    }
  }
}
